{
  "name": "@open-insight/workspace",
  "workspace": [
    "open-insight/packages/*",
    "benchmarks/*",
    "harnesses/*"
  ],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "effect": "npm:effect@^4.0.0-beta.101",
    "@effect/platform-node": "npm:@effect/platform-node@^4.0.0-beta.101"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  },
  "minimumDependencyAge": 0
}